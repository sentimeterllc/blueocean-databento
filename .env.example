# Blue Ocean pipeline configuration.
# Copy to .env and fill in. Never commit the filled-in file.

# --- Databento -------------------------------------------------------------
# API key with entitlement to the Blue Ocean dataset.
DATABENTO_API_KEY=db-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Dataset code. Blue Ocean ATS publishes as OCEA.MEMOIR.
BLUEOCEAN_DATASET=OCEA.MEMOIR
# Batch job polling.
BLUEOCEAN_JOB_POLL_SECONDS=5
BLUEOCEAN_JOB_TIMEOUT_SECONDS=7200
# Level 2 (MBO) stops being fetchable after this many days on the subscription.
BLUEOCEAN_MBO_RETENTION_DAYS=27
# UTC clock time the overnight session ends (04:00 ET = 08:00 UTC); the request
# is bounded an hour later so the whole session is covered.
BLUEOCEAN_SESSION_END_UTC=09:00:00

# --- Paths -----------------------------------------------------------------
# Root of the Hive-partitioned Parquet lake this pipeline writes.
BLUEOCEAN_ROOT=C:/data/blueocean
# Scratch space for raw .dbn.zst shards; deleted after each session converts.
BLUEOCEAN_DOWNLOAD_DIR=C:/data/blueocean_downloads
BLUEOCEAN_LOG_DIR=C:/logs/blueocean

# --- PostgreSQL (one read-only lookup; the pipeline never writes) -----------
# Holds the bizcal trading calendar, which decides WHICH sessions to request.
# It never decides what is kept from a session: every row the vendor returns is
# stored. (To restrict the lake to symbols of interest, see merge_and_sort()
# in src/blueocean/updater.py.)
DB_TRADINGDATA_CONN=postgresql://user:password@localhost:5432/tradingdata
